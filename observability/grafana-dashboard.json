{
  "title": "Condominio26 - Affidabilità",
  "panels": [
    {
      "id": 1,
      "title": "RPS per servizio",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=~\".+\"}[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 2,
      "title": "Error rate 5xx",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (service) / sum(rate(http_server_requests_seconds_count[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "options": {"tooltip": {"mode": "single"}}
    },
    {
      "id": 3,
      "title": "Latency p95 (ms)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, service)) * 1000",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 4,
      "title": "CPU / Memoria per pod",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!~\"POD|\"}[5m])) by (pod)",
          "legendFormat": "CPU {{pod}}"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{container!~\"POD|\"}) by (pod)",
          "legendFormat": "Mem {{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tenant traffic",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{tenant!=\"\"}[5m])) by (tenant)",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Logs per severity",
      "type": "barchart",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum by (level)(rate({service=~\".+\"} |= \"\" [5m]))"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
